# Firebase Configuration
# Copy this file to .env and fill in your values from the Firebase Console.
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_APP_ID=default-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Google OAuth Client ID (for Google Sign-In)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# reCAPTCHA v3 site key for Firebase App Check (optional but recommended)
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Debug token for Firebase App Check in local development ONLY
# Leave empty/unset in production. Generate a debug token in Firebase Console.
REACT_APP_APPCHECK_DEBUG_TOKEN=

# Feature flags
# Set to 'true' to enable public share collections (requires share membership setup in Firestore)
REACT_APP_ENABLE_PUBLIC_SHARES=false
