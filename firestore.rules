rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to validate string field length
    function validStringLength(str, maxLength) {
      return str is string && str.size() <= maxLength;
    }

    // Helper function to validate ticket ID format
    function validTicketId(ticketId) {
      return validStringLength(ticketId, 200) &&
             !ticketId.matches('.*[<>].*') &&  // No HTML characters
             !ticketId.lower().matches('.*javascript:.*');  // No javascript: protocol
    }

    // Helper function to validate note format
    function validNote(note) {
      return validStringLength(note, 5000) &&
             !note.matches('.*[<>].*') &&  // No HTML characters
             !note.lower().matches('.*javascript:.*');  // No javascript: protocol
    }

    // Helper function to validate share ID format
    function validShareId(shareId) {
      return validStringLength(shareId, 64) &&
             shareId.matches('^[A-Za-z0-9_-]+$');
    }

    // Helper function to validate time entry data for creates (startTime required)
    function validTimeEntryCreate(data) {
      return data.keys().hasAll(['ticketId', 'startTime', 'accumulatedMs']) &&
             validTicketId(data.ticketId) &&
             (data.startTime is number || data.startTime is timestamp) &&
             data.accumulatedMs is number &&
             data.accumulatedMs >= 0 &&
             data.accumulatedMs < 86400000 * 30 &&  // Max 30 days
             (!('endTime' in data) || data.endTime == null || data.endTime is number || data.endTime is timestamp) &&
             (!('note' in data) || validNote(data.note)) &&
             (!('status' in data) || data.status in ['submitted', 'unsubmitted']) &&
             (!('createdAt' in data) || data.createdAt is number || data.createdAt is timestamp);
    }

    // Helper function to validate time entry data for updates (startTime can be null)
    function validTimeEntryUpdate(data) {
      return data.keys().hasAll(['ticketId', 'accumulatedMs']) &&
             validTicketId(data.ticketId) &&
             (!('startTime' in data) || data.startTime == null || data.startTime is number || data.startTime is timestamp) &&
             data.accumulatedMs is number &&
             data.accumulatedMs >= 0 &&
             data.accumulatedMs < 86400000 * 30 &&  // Max 30 days
             (!('endTime' in data) || data.endTime == null || data.endTime is number || data.endTime is timestamp) &&
             (!('note' in data) || validNote(data.note)) &&
             (!('status' in data) || data.status in ['submitted', 'unsubmitted']) &&
             (!('submissionDate' in data) || data.submissionDate == null || data.submissionDate is number || data.submissionDate is timestamp) &&
             (!('createdAt' in data) || data.createdAt is number || data.createdAt is timestamp);
    }

    // Helper function to validate ticket status data
    function validTicketStatus(data) {
      return data.keys().hasAll(['ticketId', 'isClosed']) &&
             validTicketId(data.ticketId) &&
             data.isClosed is bool;
    }

    // Helper function to validate error report data
    function validErrorReport(data) {
      return data.keys().hasAll(['message', 'source', 'createdAt']) &&
             validStringLength(data.message, 2000) &&
             validStringLength(data.source, 200) &&
             data.createdAt is number &&
             (!('stack' in data) || validStringLength(data.stack, 8000)) &&
             (!('url' in data) || validStringLength(data.url, 500)) &&
             (!('userAgent' in data) || validStringLength(data.userAgent, 500)) &&
             (!('userId' in data) || data.userId == null || data.userId == request.auth.uid);
    }

    // Check if an authenticated user is a member of a public share.
    // The share document must exist at /artifacts/default-app-id/public_shares/{shareId}
    // and contain a `members` array that includes the requesting user's UID.
    function isShareMember(shareId) {
      return validShareId(shareId) &&
             request.auth != null &&
             exists(/databases/$(database)/documents/artifacts/default-app-id/public_shares/$(shareId)) &&
             get(/databases/$(database)/documents/artifacts/default-app-id/public_shares/$(shareId)).data.members is list &&
             request.auth.uid in get(/databases/$(database)/documents/artifacts/default-app-id/public_shares/$(shareId)).data.members;
    }

    // Validate the members list for a public share: bounded size to prevent
    // resource exhaustion via unbounded arrays.
    function validMembers(members) {
      return members is list && members.size() >= 1 && members.size() <= 100;
    }

    // User-specific data paths
    match /artifacts/default-app-id/users/{userId}/time_entries/{entryId} {
      // Users can read their own time entries
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can create their own time entries with valid data (startTime required)
      allow create: if request.auth != null &&
                    request.auth.uid == userId &&
                    validTimeEntryCreate(request.resource.data);

      // Users can update their own time entries (startTime can be null for pausing)
      allow update: if request.auth != null &&
                    request.auth.uid == userId &&
                    validTimeEntryUpdate(request.resource.data);

      // Users can delete their own time entries
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /artifacts/default-app-id/users/{userId}/ticket_statuses/{statusId} {
      // Users can read and delete their own ticket statuses
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // Users can create and update only their own ticket statuses with valid data
      allow create, update: if request.auth != null &&
                              request.auth.uid == userId &&
                              validTicketStatus(request.resource.data);
    }

    // Public/shared data paths
    // Access is disabled by default unless a share document exists and lists the
    // requesting user as a member. To enable sharing, create a document at
    // /artifacts/{appId}/public_shares/{shareId} with { members: ["uid1", "uid2"] }.
    match /artifacts/default-app-id/public_data/{shareId}/time_entries/{entryId} {
      allow read: if isShareMember(shareId);

      allow create: if isShareMember(shareId) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       validTimeEntryCreate(request.resource.data);

      allow update: if isShareMember(shareId) &&
                       validTimeEntryUpdate(request.resource.data) &&
                       resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isShareMember(shareId) &&
                       resource.data.createdBy == request.auth.uid;
    }

    match /artifacts/default-app-id/public_data/{shareId}/ticket_statuses/{statusId} {
      allow read: if isShareMember(shareId);

      allow create: if isShareMember(shareId) &&
                       validTicketStatus(request.resource.data) &&
                       request.resource.data.createdBy == request.auth.uid;

      allow update: if isShareMember(shareId) &&
                       validTicketStatus(request.resource.data) &&
                       resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isShareMember(shareId) &&
                       resource.data.createdBy == request.auth.uid;
    }

    // Public share metadata documents
    match /artifacts/default-app-id/public_shares/{shareId} {
      // Only the user creating the share can create it, and they must be in members.
      // createdBy is required so ownership is enforceable later.
      allow create: if validShareId(shareId) &&
                       request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid &&
                       validMembers(request.resource.data.members) &&
                       request.auth.uid in request.resource.data.members;

      // Members can read share metadata.
      allow read: if isShareMember(shareId);

      // Only members can update, ownership cannot be transferred, and the
      // owner can never be removed from the members list.
      allow update: if isShareMember(shareId) &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       validMembers(request.resource.data.members) &&
                       resource.data.createdBy in request.resource.data.members;

      // Only the owner can delete the share.
      allow delete: if request.auth != null &&
                       resource.data.createdBy == request.auth.uid;
    }

    // Error monitoring: clients may only create reports; reading, updating,
    // and deleting is denied (managed via console/admin tooling only).
    match /artifacts/default-app-id/error_reports/{reportId} {
      allow create: if request.auth != null && validErrorReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
